{
  "name": "pada-ds",
  "private": false,
  "version": "1.1.0",
  "description": "Singular design system for React applications, built with TypeScript and Vite.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/pada.js",
  "module": "./dist/pada.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pada.js",
      "default": "./dist/pada.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./styles.css": "./dist/pada.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.scss": "./dist/tokens.scss",
    "./tokens.json": "./dist/tokens.json",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./base.css": "./dist/base.css",
    "./manifest.json": "./dist/manifest.json",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/migrate-tokens.mjs",
    "tokens/index.mjs",
    "tokens/palette.mjs"
  ],
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "typescript",
    "pada",
    "design-tokens"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.package.json",
    "build:styles": "vite build",
    "build:tokens": "node ./scripts/build-tokens.mjs",
    "build:manifest": "node ./scripts/gen-manifest.mjs",
    "build": "npm run clean && npm run build:styles && npm run build:types && npm run build:tokens && npm run build:manifest",
    "check:manifest": "node ./scripts/gen-manifest.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check:tokens": "node ./scripts/build-tokens.mjs --check && node ./scripts/check-tokens.mjs",
    "smoke:consumer": "node ./scripts/smoke-consumer.mjs",
    "prepublishOnly": "npm run build",
    "tokens:sync": "node ./scripts/sync-tokens-angular.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react-router-dom": "^7.15.1",
    "storybook": "^10.6.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bin": {
    "pada-tokens-migrate": "./scripts/migrate-tokens.mjs"
  }
}
