{
  "name": "pada",
  "version": "1.2.1",
  "private": true,
  "description": "Pada for React: the pada-ds library (projects/pada-ds) and the Pada website and docs (site).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "projects/pada-ds",
    "site"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w pada-ds",
    "build:site": "npm run build -w site",
    "check:manifest": "npm run check:manifest -w pada-ds",
    "lint": "eslint .",
    "test": "npm test -w pada-ds && npm run docs:check",
    "tokens:check": "npm run tokens:check -w pada-ds",
    "check:tokens": "npm run tokens:check",
    "tokens:sync": "node ./scripts/sync-tokens-angular.mjs",
    "smoke:consumer": "node ./scripts/smoke-consumer.mjs",
    "storybook": "npm run storybook -w pada-ds",
    "build-storybook": "npm run build-storybook -w pada-ds",
    "chromatic": "npm run chromatic -w pada-ds",
    "docs:data": "node ./scripts/gen-docs-data.mjs",
    "docs:check": "node ./scripts/gen-docs-data.mjs --check",
    "storybook:sync": "node ./scripts/sync-storybook-angular.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
