{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "composite": false,
    "sourceMap": false,
    "types": [
      "prismjs",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src/index.ts",
    "src/components",
    "src/headless",
    "src/types/styles.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/test"
  ]
}
